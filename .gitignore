# Generated experiment state. The small frozen evaluation manifests below are
# versioned; training data, checkpoints, activations, generations, and API logs
# are rebuilt or restored separately.
artifacts/*
!artifacts/.gitkeep
!artifacts/manifests/
artifacts/manifests/*
!artifacts/manifests/broad_em_development_v1.jsonl
!artifacts/manifests/mechanistic_ood_v1.jsonl
!artifacts/manifests/medical_all_tasks_subspace_fit_v1.jsonl
!artifacts/manifests/medical_all_tasks_subspace_select_v1.jsonl
!artifacts/manifests/medical_all_tasks_subspace_causal_v1.jsonl

outputs/*
!outputs/.gitkeep
